# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database Connection String
DATABASE_URL="postgresql://username:password@host:port/database"

# Server Port & App URL
PORT=5000
APP_URL=http://localhost:5173

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# ==========================================
# MIDTRANS PAYMENT GATEWAY CONFIGURATION
# ==========================================
# Ganti dengan 'production' jika akun Midtrans Anda sudah live/aktif berbadan usaha/perorangan
VITE_MIDTRANS_ENV="sandbox"
VITE_MIDTRANS_MERCHANT_ID="Gxxxxxxxx"
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"

# ==========================================
# BITESHIP LOGISTICS AGGREGATOR CONFIGURATION
# ==========================================
BITESHIP_API_KEY=your_biteship_api_key

# ==========================================
# EMAIL SMTP CONFIGURATION
# ==========================================
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ==========================================
# CLOUDFLARE / KROOMBOX HOSTING PANEL CONFIGURATION
# ==========================================
KROOMBOX_PANEL_URL=https://panel.kroombox.com
KROOMBOX_API_TOKEN=kp_live_xxxxxxxxxxxxxxxx
KROOMBOX_TUNNEL_ID=your_cloudflare_tunnel_id
