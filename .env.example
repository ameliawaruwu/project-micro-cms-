# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database Connection String
DATABASE_URL="postgresql://username:password@host:port/database"

# Server Port & App URL
PORT=5000
APP_URL=http://localhost:5173

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# ==========================================
# MIDTRANS PAYMENT GATEWAY CONFIGURATION
# ==========================================
# Ganti dengan 'production' jika akun Midtrans Anda sudah live/aktif berbadan usaha/perorangan
VITE_MIDTRANS_ENV="sandbox"
VITE_MIDTRANS_MERCHANT_ID="Gxxxxxxxx"
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"

# ==========================================
# BITESHIP LOGISTICS AGGREGATOR CONFIGURATION
# ==========================================
BITESHIP_API_KEY=your_biteship_api_key

# ==========================================
# EMAIL SMTP CONFIGURATION
# ==========================================
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ==========================================
# KROOMBOX PANEL API (publikasi toko: <slug>.lapakq.com & domain kustom)
# ==========================================
# Buat API key di panel dengan scope domains:write dan domains:read saja.
KROOMBOX_PANEL_API_URL=https://panel.kroombox.com/api
KROOMBOX_SITE_ID=s_xxxxxxxxxxxxx_xxxxxx
KROOMBOX_PANEL_API_KEY=kp_live_xxxxxxxxxxxxxxxx

# ==========================================
# LAPAKQ PUBLIC API V1 KEYS (READ-ONLY)
# ==========================================
# Master Read-Only API Key untuk akses semua katalog publik & komunitas
LAPAKQ_READONLY_API_KEY=your_lapakq_master_readonly_api_key
LAPAKQ_API_PUBLIC_KEY=your_lapakq_master_readonly_api_key

# ==========================================
# CDNKROOMBOX (upload gambar produk, logo, QRIS, layout, avatar)
# ==========================================
# API key project CDN (kb_...). Hanya dipakai server; jangan diberi awalan VITE_.
CDN_API_URL=https://api-cdn.kroombox.com
CDN_API_KEY=kb_xxxxxxxxxxxxxxxxxxxxxxxx
